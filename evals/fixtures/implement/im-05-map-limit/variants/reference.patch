@@ -0,0 +1,7 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mapLimit } from '../src/map-limit.mjs';
+
+test('maps every item in order', async () => {
+  assert.deepEqual(await mapLimit([1, 2, 3], 2, async (x) => x * 2), [2, 4, 6]);
+});
