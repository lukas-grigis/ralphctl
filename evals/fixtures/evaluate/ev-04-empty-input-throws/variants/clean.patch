diff --git a/src/first-word.mjs b/src/first-word.mjs
new file mode 100644
index 0000000..a32e9bb
--- /dev/null
+++ b/src/first-word.mjs
@@ -0,0 +1,4 @@
+export const firstWord = (text) => {
+  const match = text.trim().match(/\S+/);
+  return match === null ? '' : match[0];
+};
diff --git a/test/first-word.test.mjs b/test/first-word.test.mjs
new file mode 100644
index 0000000..882d2da
--- /dev/null
+++ b/test/first-word.test.mjs
@@ -0,0 +1,19 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { firstWord } from '../src/first-word.mjs';
+
+test('returns the first word', () => {
+  assert.equal(firstWord('hello world'), 'hello');
+});
+
+test('skips leading whitespace', () => {
+  assert.equal(firstWord('   spaced out'), 'spaced');
+});
+
+test('returns the empty string for empty input', () => {
+  assert.equal(firstWord(''), '');
+});
+
+test('returns the empty string for whitespace-only input', () => {
+  assert.equal(firstWord('   '), '');
+});
