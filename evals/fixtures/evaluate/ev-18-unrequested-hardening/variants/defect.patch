+export const chunk = (items, size) => {
+  if (size < 1) throw new RangeError(`size must be at least 1, got ${size}`);
+  const groups = [];
+  for (let i = 0; i <= items.length; i += size) {
+    groups.push(items.slice(i, i + size));
+  }
+  return groups;
+};
