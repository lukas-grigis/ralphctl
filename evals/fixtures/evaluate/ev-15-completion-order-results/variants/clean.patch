@@ -0,0 +1,19 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mapAsync } from '../src/map-async.mjs';
+
+const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+
+test('maps every item', async () => {
+  assert.deepEqual(await mapAsync([1, 2, 3], async (x) => x * 2), [2, 4, 6]);
+});
+
+test('keeps input order when calls finish out of order', async () => {
+  const delays = [30, 5, 15];
+  const out = await mapAsync(delays, async (ms, i) => { await sleep(ms); return i; });
+  assert.deepEqual(out, [0, 1, 2]);
+});
+
+test('an empty input resolves to an empty array', async () => {
+  assert.deepEqual(await mapAsync([], async (x) => x), []);
+});
