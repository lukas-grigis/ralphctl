@@ -0,0 +1,11 @@
+export const mapAsync = (items, fn) =>
+  new Promise((resolve, reject) => {
+    const out = [];
+    if (items.length === 0) return resolve(out);
+    items.forEach((item, index) => {
+      Promise.resolve(fn(item, index)).then((value) => {
+        out.push(value);
+        if (out.length === items.length) resolve(out);
+      }, reject);
+    });
+  });
diff --git a/test/map-async.test.mjs b/test/map-async.test.mjs
new file mode 100644
index 0000000..9abae17
--- /dev/null
+++ b/test/map-async.test.mjs
@@ -0,0 +1,15 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mapAsync } from '../src/map-async.mjs';
+
+test('maps every item', async () => {
+  assert.deepEqual(await mapAsync([1, 2, 3], async (x) => x * 2), [2, 4, 6]);
+});
+
+test('rejects when a call rejects', async () => {
+  await assert.rejects(mapAsync([1, 2], async (x) => { if (x === 2) throw new Error('boom'); return x; }), /boom/);
+});
+
+test('an empty input resolves to an empty array', async () => {
+  assert.deepEqual(await mapAsync([], async (x) => x), []);
+});
