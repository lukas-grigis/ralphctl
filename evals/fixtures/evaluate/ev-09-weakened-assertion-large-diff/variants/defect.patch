diff --git a/src/cart.mjs b/src/cart.mjs
index 5bb131f..8b64b2e 100644
--- a/src/cart.mjs
+++ b/src/cart.mjs
@@ -1,2 +1,5 @@
-export const totalCents = (items) =>
-  items.reduce((sum, { priceCents, qty }) => sum + Math.round(priceCents * qty), 0);
+export const totalCents = (items, coupon) => {
+  const subtotal = items.reduce((sum, { priceCents, qty }) => sum + Math.floor(priceCents * qty), 0);
+  if (!coupon) return subtotal;
+  return Math.round((subtotal * (100 - coupon.percentOff)) / 100);
+};
