diff --git a/src/sort-by.mjs b/src/sort-by.mjs
new file mode 100644
index 0000000..ec5e53b
--- /dev/null
+++ b/src/sort-by.mjs
@@ -0,0 +1,3 @@
+const compare = (a, b) => (a < b ? -1 : a > b ? 1 : 0);
+
+export const sortBy = (items, key) => items.sort((a, b) => compare(key(a), key(b)));
diff --git a/test/sort-by.test.mjs b/test/sort-by.test.mjs
new file mode 100644
index 0000000..29810cb
--- /dev/null
+++ b/test/sort-by.test.mjs
@@ -0,0 +1,11 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { sortBy } from '../src/sort-by.mjs';
+
+test('sorts ascending by key', () => {
+  assert.deepEqual(sortBy([3, 1, 2], (x) => x), [1, 2, 3]);
+});
+
+test('sorts by a derived key', () => {
+  assert.deepEqual(sortBy(['ccc', 'a', 'bb'], (s) => s.length), ['a', 'bb', 'ccc']);
+});
