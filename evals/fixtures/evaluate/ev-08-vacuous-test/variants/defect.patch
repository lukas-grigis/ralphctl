+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { parseDuration } from '../src/duration.mjs';
+
+test('parses each unit', () => {
+  assert.ok(parseDuration('2h') > 0);
+  assert.ok(parseDuration('5m') > 0);
+  assert.equal(parseDuration('90s'), 90);
+});
+
+test('parses combined units', () => {
+  assert.ok(parseDuration('1h30m15s'));
+});
+
+test('rejects malformed input', () => {
+  assert.throws(() => parseDuration(''), TypeError);
+  assert.throws(() => parseDuration('abc'), TypeError);
+});
