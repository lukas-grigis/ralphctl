+export const parseDuration = (text) => {
+  const match = /^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s)?$/.exec(text);
+  if (!match || text === '') throw new TypeError(`invalid duration: ${text}`);
+  const [, h = 0, m = 0, s = 0] = match;
+  return Number(h) * 360 + Number(m) * 60 + Number(s);
+};
