diff --git a/src/format-bytes.mjs b/src/format-bytes.mjs
index 6e15283..5bac7cc 100644
--- a/src/format-bytes.mjs
+++ b/src/format-bytes.mjs
@@ -3,8 +3,8 @@ const UNITS = ['B', 'KB', 'MB', 'GB'];
 export const formatBytes = (n) => {
   let value = n;
   let i = 0;
-  while (value >= 1024 && i < UNITS.length - 1) {
-    value /= 1024;
+  while (value >= 1000 && i < UNITS.length - 1) {
+    value /= 1000;
     i += 1;
   }
   return `${Number.isInteger(value) ? value : value.toFixed(1)} ${UNITS[i]}`;
