 const UNITS = ['B', 'KB', 'MB', 'GB'];
+const divisor = (i) => (i >= 2 ? 1024 ** i : 1000 ** i);
 
 export const formatBytes = (n) => {
-  let value = n;
   let i = 0;
-  while (value >= 1024 && i < UNITS.length - 1) {
-    value /= 1024;
