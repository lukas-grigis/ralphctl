@@ -0,0 +1,6 @@
+// maxLength truncates the result without leaving a trailing hyphen.
+export const slugify = (text, { maxLength = 80 } = {}) =>
+  text
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
