{
  "name": "ralphctl",
  "version": "0.21.0",
  "description": "Agent harness for long-running AI coding tasks — orchestrates Claude Code, GitHub Copilot, OpenAI Codex, and OpenCode across repositories",
  "homepage": "https://github.com/lukas-grigis/ralphctl",
  "type": "module",
  "license": "MIT",
  "author": "Lukas Grigis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukas-grigis/ralphctl.git"
  },
  "bugs": {
    "url": "https://github.com/lukas-grigis/ralphctl/issues"
  },
  "keywords": [
    "cli",
    "agent-harness",
    "ralph",
    "ralph-harness",
    "ralph-loop",
    "claude-code",
    "github-copilot",
    "codex",
    "opencode",
    "ai-coding",
    "task-orchestration",
    "anthropic",
    "developer-tools",
    "long-running-agents",
    "generator-evaluator"
  ],
  "bin": {
    "ralphctl": "dist/cli.mjs"
  },
  "files": [
    "dist/",
    "THIRD-PARTY-NOTICES.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsx scripts/build-assets.ts",
    "prepublishOnly": "pnpm build",
    "dev": "NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 tsx src/index.ts",
    "mock": "tsx scripts/seed-mock.ts",
    "dev:heap-snapshot": "mkdir -p .diagnostics && NODE_OPTIONS='--max-old-space-size=8192 --heapsnapshot-near-heap-limit=2 --diagnostic-dir=.diagnostics' tsx src/index.ts",
    "start": "NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 tsx src/index.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify:coverage": "pnpm coverage",
    "coverage:unused": "tsx scripts/find-unused.ts",
    "deadcode": "knip",
    "skills:update": "tsx scripts/sync-skills.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "ink": "^7.1.1",
    "proper-lockfile": "^4.1.2",
    "react": "^19.3.0",
    "typescript-result": "^3.5.2",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.5.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "ink-testing-library": "^4.0.0",
    "jiti": "^2.7.0",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{md,json,yml,yaml}": "prettier --write"
  }
}
